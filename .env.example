# Copy to .env (never commit it) and fill in only the providers you want to use.
# Start the bridge with: npm run bridge

# Port and the atlas pages allowed to call the bridge (comma separated).
BRIDGE_PORT=3017
BRIDGE_ORIGINS=http://localhost:3016,http://127.0.0.1:3016

# Claude Code CLI ("claude" in your PATH, signed in). Optional model override.
# CLAUDE_CODE_MODEL=

# Codex CLI ("codex" in your PATH, signed in). Optional model override.
# CODEX_MODEL=

# Anthropic API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI API (or any OpenAI-compatible service via OPENAI_BASE_URL)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local model with an OpenAI-compatible API (Ollama, LM Studio, llama.cpp server...)
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_KEY=
